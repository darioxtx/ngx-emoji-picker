{
  "name": "ngx-emoji-picker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng build emoji-picker-lib && ng serve --port 4229 ",
    "build": "ng build emoji-picker-lib",
    "build:demo": "ng build demo --configuration=production && npm run copy-redirects",
    "copy-redirects": "node scripts/copy-redirects.js",
    "serve": "ng serve --port 4223",
    "build:watch": "ng build emoji-picker-lib --watch",
    "watch": "ng build --watch --configuration=development",
    "format": "npx prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --coverage",
    "build-prod": "ng build emoji-picker-lib --configuration=production",
    "publish": "npm run build-prod && cd dist/ngx-emoji-picker && npm publish --access public",
    "publish-beta": "npm run build-prod && cd dist/ngx-emoji-picker && npm publish --access public --tag beta",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "link": "ng build emoji-picker-lib && cd dist/ngx-emoji-picker && npm link && cd ../../projects/emoji-picker-lib && ng build --watch",
    "publish-demo": "npm run build:demo && netlify deploy --branch=master --prod"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinBelien/ngx-emoji-picker.git"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/cdk": "^19.1.0",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/elements": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/material": "^19.1.0",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "18.3.0",
    "@angular-eslint/eslint-plugin": "18.3.0",
    "@angular-eslint/eslint-plugin-template": "18.3.0",
    "@angular-eslint/schematics": "18.3.0",
    "@angular-eslint/template-parser": "18.3.0",
    "@angular/build": "^20.3.22",
    "@angular/cli": "^20.3.22",
    "@angular/compiler-cli": "^20.3.18",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "angular-eslint": "18.3.0",
    "concurrently": "^8.2.2",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "jest-preset-angular": "^14.5.0",
    "ng-packagr": "^20.3.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.1.0",
    "wait-on": "^7.2.0"
  }
}